{
  "name": "bible-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free, no-key Model Context Protocol (MCP) server for the public Bible API — read scripture across 35+ Bible versions in 9 language families from any MCP client. Powers mcp.midvash.com.",
  "license": "MIT",
  "homepage": "https://mcp.midvash.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/midvash/bible-mcp.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "glama:stdio": "node scripts/glama-stdio-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260604.1",
    "typescript": "~6.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.98.0"
  }
}
